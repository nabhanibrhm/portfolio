---
import { experiences, navLinks, projects, site } from "../data/site";
---

<section
  id="hero"
  aria-label="Intro"
  tabindex="-1"
  class="wrap flex outline-none min-h-[calc(100svh-var(--header-h))] flex-col pt-14"
>
  <!-- Top row: identity (left) · location + local time (right, hidden < 860px) -->
  <div class="flex items-center justify-between gap-6" data-reveal>
    <div class="flex items-center gap-4">
      <span
        class="relative block h-14 w-14 shrink-0 overflow-hidden rounded-full border border-line bg-background"
      >
        <!-- Source is a tall transparent PNG-style canvas: crop + zoom to the face -->
        <img
          src="/neutral-memoji.webp"
          alt="Memoji of Luthfi"
          width="56"
          height="56"
          class="avatar h-full w-full object-cover object-top"
        />
      </span>
      <div class="flex flex-col gap-1.5">
        <span class="mono text-foreground">{site.name}</span>
        <span class="mono text-mute">{site.role}</span>
      </div>
    </div>
    <div class="hidden flex-col gap-1.5 text-right min-[860px]:flex">
      <span class="mono text-foreground">{site.location}</span>
      <time class="mono text-mute"><span data-clock>--:--</span> WIB · UTC+7</time>
    </div>
  </div>

  <!-- Headline -->
  <h1
    class="mt-auto pt-[72px] text-[clamp(54px,10.2vw,156px)] font-medium leading-[0.9] tracking-[-0.055em]"
  >
    {
      site.headline.map((line) => (
        <span class="block -mb-[0.06em] pb-[0.14em] pt-[0.03em]" data-mask>
          <span class="block">
            {line.map((seg) => (seg.accent ? <span class="acc">{seg.text}</span> : seg.text))}
          </span>
        </span>
      ))
    }
  </h1>

  <!-- Tagline | CTAs -->
  <div class="mt-12 grid items-end gap-8 min-[860px]:grid-cols-2">
    <p class="m-0 max-w-[520px] text-xl leading-[1.45] text-mute" data-reveal>{site.tagline}</p>
    <div class="flex flex-wrap items-center gap-6" data-reveal>
      <a
        href="/#projects"
        data-nav
        data-magnetic
        class="hero-btn inline-flex h-[52px] items-center gap-2.5 rounded-full bg-accent px-6 text-[15px] font-medium text-accent-on"
      >
        View work
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M6 13l6 6 6-6"></path>
        </svg>
      </a>
      <a href="/#contact" data-nav class="ul on py-3 text-[15px]">Get in touch</a>
    </div>
  </div>

  <!-- Index bar (hidden < 860px) -->
  <div
    class="mt-16 hidden items-center justify-between border-t border-line py-5 min-[860px]:flex"
    data-reveal
  >
    <span class="mono text-mute">Scroll ↓</span>
    <div class="flex gap-10">
      {
        navLinks.map((l, i) => (
          <a href={l.href} data-nav class="mono ul text-mute">
            ({String(i + 1).padStart(2, "0")}) {l.label}
          </a>
        ))
      }
    </div>
    <span class="mono text-mute">
      {experiences.length} roles · {projects.length} projects
    </span>
  </div>
</section>

<style>
  /* Zoom the square crop in on the face (face sits ~47% / 68% of the crop box) */
  .avatar {
    transform: scale(1.7);
    transform-origin: 47% 68%;
  }
  .hero-btn {
    transition:
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      translate 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.3s ease;
  }
  .hero-btn:hover {
    transform: translateY(-2px);
  }
</style>

<script>
  import { gsap } from "../lib/gsap";
  import { MASK, REVEAL } from "../lib/motion";
  import { onPageLoad } from "../lib/page";
  import { guard } from "../lib/reveal";

  // Lines unmask (rise from below, staggered), then the fade-ups follow.
  function runHeroIntro() {
    guard("hero", (hero) => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const lines = hero.querySelectorAll<HTMLElement>("[data-mask] > *");
      const fades = hero.querySelectorAll<HTMLElement>("[data-reveal]");

      if (reduce) {
        gsap.set(lines, { yPercent: 0 });
        gsap.set(fades, { autoAlpha: 1, y: 0 });
        return;
      }

      const tl = gsap.timeline();
      tl.fromTo(lines, MASK.from, { ...MASK.to, stagger: MASK.stagger });
      tl.fromTo(fades, REVEAL.from, { ...REVEAL.to, stagger: REVEAL.stagger }, "-=0.85");
    });
  }

  // Wait for the preloader on first load; run immediately on later navigations.
  function scheduleHeroIntro() {
    if ((window as any).__preloaded) runHeroIntro();
    else window.addEventListener("preloader:done", runHeroIntro, { once: true });
  }

  onPageLoad("hero", scheduleHeroIntro);
</script>
