---
import { site, socialLinks } from "../data/site";
---

<section id="contact" aria-labelledby="contact-h" class="anchor-offset wrap pt-32 md:pt-[200px]">
  <div
    class="flex flex-col items-start gap-3 border-b border-line pb-6 min-[860px]:flex-row min-[860px]:items-baseline min-[860px]:justify-between"
    data-reveal
  >
    <span class="mono whitespace-nowrap text-mute">(04) — Contact</span>
    <span class="mono flex items-center gap-2.5 whitespace-nowrap text-mute">
      <span class="live h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      {site.availability}
    </span>
  </div>

  <h2
    id="contact-h"
    class="m-0 mt-16 text-[clamp(56px,9.6vw,148px)] font-medium leading-[0.9] tracking-[-0.055em]"
  >
    {
      site.contactHeadline.map((line) => (
        <span class="block -mb-[0.06em] pb-[0.14em] pt-[0.03em]" data-mask>
          <span class="block">
            {line.map((seg) => (seg.accent ? <span class="acc">{seg.text}</span> : seg.text))}
          </span>
        </span>
      ))
    }
  </h2>

  <div class="mt-20 grid items-end gap-12 min-[860px]:grid-cols-2">
    <!-- Email + copy -->
    <div class="flex min-w-0 flex-col gap-5" data-reveal>
      <span class="mono text-mute">Email</span>
      <a
        href={`mailto:${site.email}`}
        class="ul on max-w-full self-start text-[clamp(24px,2.6vw,38px)] leading-[1.15] tracking-[-0.02em] [overflow-wrap:anywhere]"
      >
        {site.email}
      </a>
      <button
        type="button"
        data-copy-email={site.email}
        class="btn inline-flex h-12 cursor-pointer items-center gap-2.5 self-start rounded-full border border-chip bg-transparent px-5 text-[15px] text-foreground"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11" rx="2"></rect>
          <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
        </svg>
        <span data-copy-label>Copy email</span>
      </button>
    </div>

    <!-- Social -->
    <nav aria-label="Social" data-reveal>
      <ul class="m-0 list-none border-b border-line p-0">
        {
          socialLinks.map((l) => (
            <li class="border-t border-line">
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="social flex items-center justify-between py-5 text-xl"
              >
                <span class="ul">
                  {l.label}
                  <span class="sr-only"> (opens in new tab)</span>
                </span>
                <span class="mono text-mute" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Toast live region: in the DOM from the start so screen readers announce it -->
  <div
    id="toast"
    role="status"
    aria-live="polite"
    class="pointer-events-none fixed bottom-8 left-1/2 z-50 flex -translate-x-1/2 items-center gap-2.5 rounded-full bg-foreground px-5 py-3.5 text-sm text-background opacity-0 transition-opacity duration-300"
  >
    <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
    <span data-toast-text></span>
  </div>
</section>

<style>
  /* The whole row is the hit area, so the label's underline draws on row hover/focus */
  .social:hover .ul::after,
  .social:focus-visible .ul::after {
    transform: scaleX(1);
  }
</style>

<script>
  import { gsap, ScrollTrigger } from "../lib/gsap";
  import { MASK, REVEAL, trigger } from "../lib/motion";
  import { onPageLoad } from "../lib/page";
  import { guard } from "../lib/reveal";

  // --- Reveals: headline unmasks, the rest fades up -------------------------
  function revealContact() {
    guard("contact", (el) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const masks = el.querySelectorAll<HTMLElement>("[data-mask] > *");
      const reveals = el.querySelectorAll<HTMLElement>("[data-reveal]");

      gsap.fromTo(masks, MASK.from, {
        ...MASK.to,
        stagger: MASK.stagger,
        scrollTrigger: trigger(masks[0], "top 85%"),
      });
      reveals.forEach((item) => {
        gsap.fromTo(item, REVEAL.from, { ...REVEAL.to, scrollTrigger: trigger(item, "top 90%") });
      });
      ScrollTrigger.refresh();
    });
  }

  // --- Copy email + toast ----------------------------------------------------
  let toastTimer: number | undefined;
  let labelTimer: number | undefined;

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      /* Clipboard API missing or denied: fall through to the legacy path */
    }
    try {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;left:-9999px;top:0;opacity:0";
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand("copy");
      ta.remove();
      return ok;
    } catch {
      return false;
    }
  }

  function showToast(message: string) {
    const toast = document.getElementById("toast");
    const text = toast?.querySelector<HTMLElement>("[data-toast-text]");
    if (!toast || !text) return;
    text.textContent = message;
    toast.style.opacity = "1";
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.style.opacity = "0";
    }, 2000);
  }

  function initCopy() {
    const btn = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    if (!btn) return;
    const label = btn.querySelector<HTMLElement>("[data-copy-label]");
    const email = btn.dataset.copyEmail || "";
    btn.addEventListener("click", async () => {
      const ok = await copyText(email);
      if (!ok) {
        showToast(`Copy failed — email: ${email}`);
        return;
      }
      showToast("Email copied to clipboard");
      if (label) {
        label.textContent = "Copied";
        window.clearTimeout(labelTimer);
        labelTimer = window.setTimeout(() => (label.textContent = "Copy email"), 2000);
      }
    });
  }

  onPageLoad("contact", () => {
    revealContact();
    initCopy();
  });
  document.addEventListener("astro:before-swap", () => {
    window.clearTimeout(toastTimer);
    window.clearTimeout(labelTimer);
  });
</script>
