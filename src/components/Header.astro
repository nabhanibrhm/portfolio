---
import { navLinks, site } from "../data/site";

interface Props {
  /** "home": full nav + mobile menu. "project": minimal bar with a back link. */
  variant?: "home" | "project";
}
const { variant = "home" } = Astro.props;
const isHome = variant === "home";

// "Luthfi Nabhan Ibrahim" → first name + the highlighted word ("Nabhan")
const [first] = site.name.split(" ");
---

<header id="site-header" class="sticky top-0 z-50 border-b border-line bg-background">
  <div class="wrap flex h-[var(--header-h)] items-center justify-between gap-6">
    <!-- Logo + wordmark -->
    <a
      href="/"
      data-nav
      aria-label={`${site.name}, back to top`}
      class="flex min-h-[44px] items-center gap-3"
    >
      <svg class="h-7 w-7 text-accent" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <path
          d="M4 4V24H12V4L24 24V4"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linejoin="miter"
          stroke-linecap="square"></path>
      </svg>
      <span class="text-base font-semibold tracking-[-0.01em]">
        {first} <span class="acc">{site.highlight}</span>
      </span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-2">
      {
        isHome ? (
          <div class="desktop-nav mr-6 hidden items-center gap-8 min-[860px]:flex">
            {navLinks.map((l, i) => (
              <a href={l.href} data-nav data-spy={l.href} class="ul text-sm">
                <span class="mono mr-1.5 text-[10px] text-mute">{String(i + 1).padStart(2, "0")}</span>
                {l.label}
              </a>
            ))}
          </div>
        ) : (
          <a href="/#projects" data-nav class="ul mr-4 py-3 text-sm">
            ← All projects
          </a>
        )
      }

      <!-- Theme toggle (moon in dark, sun in light) -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch to light theme"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-chip text-foreground"
      >
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>

      <!-- Menu button (under 860px) -->
      {isHome && (
      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-11 w-11 items-center justify-center text-foreground min-[860px]:hidden"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M3 9h18M3 15h18"></path>
        </svg>
      </button>
      )}
    </nav>
  </div>

  <!-- Scroll progress: 1px amber line on the header's bottom edge -->
  <div
    id="scroll-progress"
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-px left-0 h-px w-0 bg-accent"
  >
  </div>

  <!-- Mobile menu: full-screen modal dialog -->
  {isHome && (
  <div
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    hidden
    class="fixed inset-0 z-40 flex-col bg-background px-4 pb-10 pt-4"
  >
    <div class="flex h-14 items-center justify-end">
      <button
        id="menu-close"
        type="button"
        aria-label="Close menu"
        class="flex h-11 w-11 items-center justify-center text-foreground"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Mobile" class="mt-auto flex flex-col">
      {
        navLinks.map((l, i) => (
          <a
            href={l.href}
            data-nav
            class="flex items-baseline gap-4 border-b border-line py-[18px] text-[44px] font-medium tracking-[-0.03em]"
          >
            <span class="mono text-mute">{String(i + 1).padStart(2, "0")}</span>
            {l.label}
          </a>
        ))
      }
    </nav>
    <a
      href={`mailto:${site.email}`}
      data-nav
      class="acc mt-8 inline-flex min-h-[44px] items-center self-start text-lg"
    >
      {site.email}
    </a>
  </div>
  )}
</header>

<style>
  /* Show the icon for the active theme: moon in dark, sun in light. */
  .icon-sun {
    display: none;
  }
  :global(html.light) .icon-moon {
    display: none;
  }
  :global(html.light) .icon-sun {
    display: block;
  }
  /* The `hidden` attribute must beat the .flex display above; also never show
     the dialog at desktop widths. */
  #mobile-menu[hidden] {
    display: none;
  }
  #mobile-menu:not([hidden]) {
    display: flex;
  }
  @media (min-width: 860px) {
    #mobile-menu {
      display: none !important;
    }
  }
  /* Scroll lock while the menu is open (Lenis is stopped too, see script) */
  :global(html.menu-open),
  :global(html.menu-open body) {
    overflow: hidden;
  }
</style>

<script>
  const header = () => document.getElementById("site-header");
  const toggle = () => document.getElementById("menu-toggle");
  const menu = () => document.getElementById("mobile-menu");
  const lenis = () => (window as any).__lenis;

  const FOCUSABLE = "a[href], button:not([disabled])";

  // --- Mobile menu (modal dialog) ------------------------------------------
  function setMenu(open: boolean, restoreFocus = true) {
    const t = toggle();
    const m = menu();
    if (!t || !m) return;
    const wasOpen = !m.hasAttribute("hidden");
    if (wasOpen === open) return;

    m.toggleAttribute("hidden", !open);
    t.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("menu-open", open);
    if (open) {
      lenis()?.stop();
      document.getElementById("menu-close")?.focus();
    } else {
      lenis()?.start();
      if (restoreFocus) t.focus({ preventScroll: true });
    }
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest?.("#menu-toggle")) setMenu(true);
    else if (target.closest?.("#menu-close")) setMenu(false);
  });

  // Escape closes; Tab is trapped inside the dialog while it is open.
  document.addEventListener("keydown", (e) => {
    const m = menu();
    if (!m || m.hasAttribute("hidden")) return;
    if (e.key === "Escape") {
      e.preventDefault();
      setMenu(false);
      return;
    }
    if (e.key !== "Tab") return;
    const items = Array.from(m.querySelectorAll<HTMLElement>(FOCUSABLE));
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;
    if (!m.contains(active)) {
      e.preventDefault();
      first.focus();
    } else if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Widening past the breakpoint with the menu open must release the scroll lock.
  window.matchMedia("(min-width: 860px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false, false);
  });

  // --- Delegated nav clicks: smooth in-page scroll with sticky-header offset,
  //     and close the mobile menu on any selection. ---
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest?.("a[data-nav]") as HTMLAnchorElement | null;
    if (!a) return;
    if (a.closest("#mobile-menu")) setMenu(false);

    const href = a.getAttribute("href") || "";
    if (!href.includes("#")) return;
    const id = href.slice(href.indexOf("#"));
    if (id.length < 2) return;

    const onIndex = location.pathname === "/";
    const target = document.querySelector(id);
    if (onIndex && target) {
      e.preventDefault();
      const off = header()?.offsetHeight ?? 72;
      const l = lenis();
      if (l) l.scrollTo(target, { offset: -off });
      else (target as HTMLElement).scrollIntoView({ behavior: "smooth" });
      history.replaceState(null, "", id);
    }
  });

  // --- Theme toggle: flip the `light` class on <html> and remember the choice.
  //     (The no-flash init in Layout.astro reads this on load / after each nav.)
  function syncThemeLabel() {
    const light = document.documentElement.classList.contains("light");
    document
      .getElementById("theme-toggle")
      ?.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
  }
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest?.("#theme-toggle")) return;
    const light = document.documentElement.classList.toggle("light");
    try {
      localStorage.setItem("theme", light ? "light" : "dark");
    } catch (err) {}
    syncThemeLabel();
  });

  // --- Scroll progress (rAF-throttled, passive; Lenis scrolls the window) ---
  let ticking = false;
  function paintProgress() {
    ticking = false;
    const bar = document.getElementById("scroll-progress");
    if (!bar) return;
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    const p = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
    bar.style.width = `${p.toFixed(1)}%`;
  }
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(paintProgress);
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });

  // --- Scrollspy: mark the link for the section currently in view (.ul.on) ---
  let spy: IntersectionObserver | null = null;
  function initSpy() {
    spy?.disconnect();
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-spy]"));
    if (!links.length) return;
    const map = new Map<Element, HTMLAnchorElement>();
    links.forEach((l) => {
      const id = (l.dataset.spy || "").split("#")[1];
      const sec = id ? document.getElementById(id) : null;
      if (sec) map.set(sec, l);
    });
    spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          links.forEach((l) => {
            l.classList.remove("on");
            l.removeAttribute("aria-current");
          });
          const l = map.get(en.target);
          l?.classList.add("on");
          l?.setAttribute("aria-current", "location");
        });
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    map.forEach((_, sec) => spy!.observe(sec));
  }

  // The header persists across View Transitions, so the listeners above are
  // registered once; only page-bound state (spy, progress, menu) is reset here.
  document.addEventListener("astro:before-swap", () => {
    spy?.disconnect();
    spy = null;
    setMenu(false, false);
  });
  document.addEventListener("astro:page-load", () => {
    syncThemeLabel();
    paintProgress();
    initSpy();
    setMenu(false, false);
  });
</script>
