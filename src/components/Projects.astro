---
/* Projects grid. Pure Astro (no Vue island): nothing here needs reactive state,
   only a hover/in-view video player and scroll reveals, both tiny scripts below. */
import { firstSentence, projectNumber, projects } from "../data/site";

const chipClass =
  "mono rounded-full border border-chip px-3 py-1.5 text-[10px]";
---

<section id="projects" aria-labelledby="projects-h" class="anchor-offset wrap pt-24 md:pt-[160px]">
  <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-6" data-reveal>
    <h2 id="projects-h" class="mono m-0 whitespace-nowrap text-mute">(03) — Projects</h2>
    <span class="mono whitespace-nowrap text-mute">{projects.length} projects</span>
  </div>

  <div class="grid gap-x-6 gap-y-14 min-[860px]:grid-cols-2">
    {
      projects.map((p, i) => {
        const num = projectNumber(i);
        const summary = p.summary ?? firstSentence(p.description);

        // --- Featured row: projects with a detail page -----------------------
        if (p.slug && p.detail) {
          const meta = [num, p.category, p.year].filter(Boolean).join(" · ");
          return (
            <a
              href={`/projects/${p.slug}`}
              aria-label={`${p.title}: read the case study`}
              data-card
              class="card grid items-end gap-x-12 gap-y-6 border-t border-line pt-6 min-[860px]:col-span-2 min-[860px]:grid-cols-2"
            >
              <div
                transition:name={`${p.slug}-media`}
                data-vt-morph
                class="relative aspect-[16/10] overflow-hidden rounded-[14px] border border-line bg-tile"
              >
                <div class="thumb-in absolute inset-0">
                  <video
                    src={p.detail.video.src}
                    poster={p.detail.video.poster}
                    muted
                    playsinline
                    loop
                    preload="none"
                    aria-hidden="true"
                    tabindex="-1"
                    data-card-video
                    class="h-full w-full object-cover"
                  />
                </div>
                <span class="mono absolute left-6 top-6 flex items-center gap-2.5 rounded-full border border-line bg-background px-3 py-1.5">
                  <span class="live h-2 w-2 rounded-full bg-accent" aria-hidden="true" />
                  Demo clip
                </span>
                <span
                  class="arrow absolute right-5 top-5 inline-flex h-11 w-11 items-center justify-center rounded-full bg-accent text-accent-on"
                  aria-hidden="true"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17L17 7M8 7h9v9" />
                  </svg>
                </span>
              </div>

              <div class="flex flex-col gap-5 pb-2">
                <span class="mono text-mute">{meta}</span>
                <h3
                  transition:name={`${p.slug}-title`}
                  data-vt-title
                  class="m-0 text-[clamp(36px,4vw,56px)] font-medium leading-none tracking-[-0.045em]"
                >
                  {p.title}
                </h3>
                <p class="m-0 max-w-[560px] text-[17px] leading-[1.55] text-mute">{summary}</p>
                {
                  p.tags.length > 0 && (
                    <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
                      {p.tags.map((t) => (
                        <li class={chipClass}>{t}</li>
                      ))}
                    </ul>
                  )
                }
                <span class="ul on mt-2 self-start text-[15px]">Read case study →</span>
              </div>
            </a>
          );
        }

        // --- Typographic card: no detail page, so not a link -----------------
        return (
          <article class="flex flex-col gap-5" data-reveal>
            <div class="relative aspect-[16/10] overflow-hidden rounded-[14px] border border-line bg-tile">
              <div class="absolute inset-0 flex flex-col justify-between p-5 sm:p-7">
                <span class="mono flex items-center gap-2.5 text-mute">
                  <span class="h-2 w-2 bg-accent" aria-hidden="true" />
                  {p.category}
                </span>
                <div class="flex items-end justify-between gap-4">
                  <span
                    class="text-[clamp(96px,11vw,176px)] font-medium leading-[0.78] tracking-[-0.07em]"
                    aria-hidden="true"
                  >
                    {num}
                  </span>
                  {p.metric && <span class="mono text-right text-foreground">{p.metric}</span>}
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-3">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="m-0 text-[28px] font-medium tracking-[-0.03em]">{p.title}</h3>
                {p.year && <span class="mono text-mute">{p.year}</span>}
              </div>
              <div class="flex flex-wrap items-center justify-between gap-4">
                <span class="text-[15px] text-mute">{p.category}</span>
                {
                  p.tags.length > 0 && (
                    <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
                      {p.tags.map((t) => (
                        <li class={chipClass}>{t}</li>
                      ))}
                    </ul>
                  )
                }
              </div>
              <p class="m-0 text-[15px] leading-[1.5] text-mute">{summary}</p>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .card .thumb-in {
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .thumb-in,
  .card:focus-visible .thumb-in {
    transform: scale(1.035);
  }
  .card .arrow {
    opacity: 0;
    transform: translate(-6px, 6px);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .card:hover .arrow,
  .card:focus-visible .arrow {
    opacity: 1;
    transform: none;
  }
  /* "Read case study" line turns amber with the card hover/focus */
  .card:hover .ul.on::after,
  .card:focus-visible .ul.on::after {
    background: rgb(var(--accent));
  }
</style>

<script>
  import { gsap, ScrollTrigger } from "../lib/gsap";
  import { REVEAL, trigger } from "../lib/motion";
  import { onPageLoad } from "../lib/page";
  import { guard } from "../lib/reveal";

  let ac: AbortController | null = null;
  let io: IntersectionObserver | null = null;

  function cleanup() {
    ac?.abort();
    io?.disconnect();
    ac = null;
    io = null;
    document
      .querySelectorAll<HTMLVideoElement>("video[data-card-video]")
      .forEach((v) => v.pause());
  }

  // Card clips play on hover / keyboard focus, and while >=60% in view; they
  // pause as soon as none of those hold. Reduced motion: poster only.
  function initVideos() {
    cleanup();
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const videos = document.querySelectorAll<HTMLVideoElement>("video[data-card-video]");
    if (!videos.length) return;
    // Videos swapped in by the client router can end up with a failed media load
    // ("rejected by URL safety check" in Chromium); reset them (preload=none: no download).
    videos.forEach((v) => v.load());

    ac = new AbortController();
    const { signal } = ac;
    const state = new Map<Element, { inView: boolean; hover: boolean; focus: boolean }>();
    const sync = (v: HTMLVideoElement) => {
      const s = state.get(v)!;
      if (s.inView || s.hover || s.focus) v.play().catch(() => {});
      else v.pause();
    };

    io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          const v = en.target as HTMLVideoElement;
          state.get(v)!.inView = en.isIntersecting;
          sync(v);
        });
      },
      { threshold: 0.6 },
    );

    videos.forEach((v) => {
      state.set(v, { inView: false, hover: false, focus: false });
      const card = v.closest<HTMLElement>("[data-card]") ?? v;
      card.addEventListener(
        "pointerenter",
        (e) => {
          if (e.pointerType !== "mouse") return;
          state.get(v)!.hover = true;
          sync(v);
        },
        { signal },
      );
      card.addEventListener(
        "pointerleave",
        () => {
          state.get(v)!.hover = false;
          sync(v);
        },
        { signal },
      );
      card.addEventListener(
        "focusin",
        () => {
          if (!card.matches(":focus-visible")) return;
          state.get(v)!.focus = true;
          sync(v);
        },
        { signal },
      );
      card.addEventListener(
        "focusout",
        () => {
          state.get(v)!.focus = false;
          sync(v);
        },
        { signal },
      );
      io!.observe(v);
    });
  }

  // Scroll reveals for the header row + typographic cards (ids let Layout kill them)
  function initReveals() {
    guard("projects", (section) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      section.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.fromTo(el, REVEAL.from, { ...REVEAL.to, scrollTrigger: trigger(el) });
      });
      ScrollTrigger.refresh();
    });
  }

  onPageLoad("projects", () => {
    initReveals();
    initVideos();
  });
  document.addEventListener("astro:before-swap", cleanup);
</script>
