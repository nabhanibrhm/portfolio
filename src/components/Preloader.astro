---
import { site } from "../data/site";
---

<div id="preloader" aria-hidden="true">
  <p class="mono pl-name">{site.name}</p>
  <p class="pl-count"><span id="pl-num">0</span><span class="pl-pct">%</span></p>
  <div class="pl-bar"><span id="pl-bar"></span></div>
</div>

<style>
  /* Hidden unless the head script flagged this load (html.has-preloader) */
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    background: rgb(var(--bg));
    color: rgb(var(--fg));
  }
  :global(html.has-preloader) #preloader {
    display: flex;
  }
  #preloader.is-leaving {
    opacity: 0;
    transition: opacity 0.35s ease-in;
  }
  .pl-name {
    margin: 0;
    color: var(--mute);
  }
  .pl-count {
    display: flex;
    align-items: baseline;
    margin: 0;
    white-space: nowrap;
    font-size: clamp(72px, 14vw, 168px);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
  }
  .pl-pct {
    color: var(--mute);
  }
  .pl-bar {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
  }
  .pl-bar > span {
    display: block;
    width: 0%;
    height: 100%;
    background: rgb(var(--accent));
  }
</style>

<!-- Inline on purpose: no module/GSAP dependency, so the sequence is anchored to
     the navigation start (performance.now()) instead of to whenever the bundles
     arrive. It only plays when the head script in Layout.astro set
     html.has-preloader (home page, first visit of the session, motion allowed).
     Timeline: progress follows performance.now()/800ms, then a 350ms fade ->
     done by ~1.15s after navigation. If this script runs later than 900ms the
     count is skipped and it just fades. The hero intro is released as the fade
     starts. Nothing here waits for load, fonts or images. -->
<script is:inline>
  (() => {
    var COUNT_MS = 800;
    var EXIT_MS = 350;
    var LATE_MS = 900;
    var html = document.documentElement;
    var el = document.getElementById("preloader");
    var released = false;

    function release() {
      if (released) return;
      released = true;
      html.classList.remove("is-loading");
      window.__preloaded = true;
      window.dispatchEvent(new Event("preloader:done"));
    }
    // Used by the reveal gate's fallback (Layout.astro head script)
    window.__releasePreloader = function () {
      html.classList.remove("has-preloader", "is-loading");
      release();
    };
    function remove() {
      html.classList.remove("has-preloader");
      if (el) el.classList.remove("is-leaving");
    }

    if (!el || !html.classList.contains("has-preloader")) {
      release();
    } else {
      var num = document.getElementById("pl-num");
      var bar = document.getElementById("pl-bar");
      var done = false;
      var paint = function (p) {
        var v = Math.round(p * 100);
        if (num) num.textContent = String(v);
        if (bar) bar.style.width = v + "%";
      };
      var leave = function () {
        if (done) return;
        done = true;
        paint(1);
        release(); // hero intro starts under the fading overlay
        el.classList.add("is-leaving");
        setTimeout(remove, EXIT_MS + 30);
      };
      var ease = function (t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      };
      var tick = function () {
        if (done) return;
        var t = Math.min(1, performance.now() / COUNT_MS); // ms since navigation start
        paint(ease(t));
        if (t < 1) requestAnimationFrame(tick);
        else leave();
      };
      if (performance.now() > LATE_MS) leave();
      else requestAnimationFrame(tick);
      // Safety net (background tab: rAF is paused, never leave the page locked)
      setTimeout(leave, 2000);
    }

    // The preloader is a `transition:persist` island: after any client-side swap
    // make sure it is gone and the scroll lock is released.
    document.addEventListener("astro:after-swap", function () {
      html.classList.remove("has-preloader", "is-loading");
      release();
    });
  })();
</script>
